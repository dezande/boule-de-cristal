{
	"name": "boule-de-cristal",
	"private": true,
	"type": "module",
	"homepage": "https://dezande.github.io/boule-de-cristal/",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && node -e \"require('node:fs').cpSync('public', 'dist', { recursive: true })\" && sass --no-source-map src/styles/main.scss dist/style.css && tsc -p src && tsc -p src/sw && node scripts/check-dist.ts",
		"typecheck": "tsc -p src --noEmit && tsc -p src/sw --noEmit && tsc",
		"test": "node --test \"tests/**/*.test.ts\"",
		"serve": "npm run build && node scripts/serve.ts",
		"deploy": "node scripts/deploy.ts"
	},
	"devDependencies": {
		"@types/node": "^24.13.4",
		"sass": "^1.104.1",
		"typescript": "^7.0.2"
	}
}
